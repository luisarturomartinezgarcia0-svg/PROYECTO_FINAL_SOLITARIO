<main>

    <!-- HERO -->

    <section
        class="hero"
        id="inicio"
    >

        <div class="overlay">

            <h1>
                El Jardín de Seño Daisiry
            </h1>

            <p>
                Más que un colegio: Un hogar, una 
                comunidad, un Jardín.

            </p>

            <a href="#cita" class="btn">
                Conoce el Colegio
            </a>

        </div>

    </section>

    <!-- FORMULARIO -->

    <section
        class="cita"
        id="cita"
    >

        <h2>Agende una Cita</h2>

        <form action="/agendar-cita" method="POST">

            <input
                type="text"
                name="nombre_completo"
                placeholder="Nombre Completo"
                required
            >

            <input
                type="text"
                name="cedula"
                placeholder="Cédula"
                required
            >

            <input
                type="text"
                name="telefono"
                placeholder="Teléfono"
                required
            >

            <input
                type="email"
                name="correo"
                placeholder="Correo Electrónico"
                required
            >

            <button type="submit">
                Agendar Cita
            </button>

        </form>

    </section>

    <!-- MENU SEMANAL -->

  <section class="menu" id="menu">

    <h2>Menú Semanal</h2>

    <div class="menu-table">

    <table>

<tbody>

    {{#each menus}}

    <tr>

        <td>{{dia}}</td>

        <td>{{desayuno}}</td>

        <td>{{comida}}</td>

        <td>{{merienda}}</td>

    </tr>

    {{/each}}

</tbody>

    </table>

</div>

</section>

    <!-- GALERIA -->

    <section
        class="galeria"
        id="galeria"
    >

        <img src="/img/foto1.webp">
        <img src="/img/foto2.webp">
        <img src="/img/foto3.webp">
        

    </section>

    <!-- INSTAGRAM -->

    <section class="instagram">

        <h2>
            ¡Descubre el lugar donde la imaginación cobra vida!
        </h2>

        <a
            href="https://www.instagram.com/eljardindedaisiry"
            target="_blank"
            class="btn"
        >
            Conoce el Instagram
        </a>

    </section>

    <!-- TESTIMONIOS -->

    <section class="testimonios" id="testimonios">

    <h2>
        Lo que dicen nuestros padres
    </h2>

    <div class="testimonios-container">

    {{#each testimonios}}

        <div class="testimonio-card">

            <p>
                "{{comentario}}"
            </p>

            <h4>
                - {{nombre}}
            </h4>

        </div>

    {{/each}}

</div>

    <div class="form-testimonio">

        <h3>
            Comparte tu experiencia
        </h3>

        <form action="/guardar-testimonio" method="POST">

            <input
                type="text"
                name="nombre"
                placeholder="Tu nombre"
                required
            >

            <textarea
                name="comentario"
                placeholder="Escribe tu testimonio..."
                required
            ></textarea>

            <button type="submit">
                Enviar Testimonio
            </button>

        </form>

    </div>

</section>


    <section class="institucion">

    <h2>Nuestra Institución</h2>

    <div class="institucion-grid">

        <div class="institucion-card">

            <h3>Misión</h3>

            <p>
                Brindar una educación inclusiva, amorosa y de calidad,
                fomentando el desarrollo integral de cada niño.
            </p>

        </div>

        <div class="institucion-card">

            <h3>Visión</h3>

            <p>
                Ser una institución reconocida por su excelencia educativa,
                inclusión y compromiso con las familias.
            </p>

        </div>

        <div class="institucion-card">

            <h3>Valores</h3>

            <p>
                Amor, respeto, empatía, inclusión, responsabilidad
                y trabajo en equipo.
            </p>

        </div>

    </div>

</section>

<section class="fechas">

    <h2>Fechas Importantes</h2>

    <div class="fechas-container">

        <div class="fecha-card">
            <h3>15 Agosto</h3>
            <p>Inicio del año escolar</p>
        </div>

        <div class="fecha-card">
            <h3>21 Septiembre</h3>
            <p>Día de la Paz</p>
        </div>

        <div class="fecha-card">
            <h3>20 Diciembre</h3>
            <p>Festival Navideño</p>
        </div>

    </div>

</section>

<section class="faq">

    <h2>Preguntas Frecuentes</h2>

    <div class="faq-item">

        <button class="faq-question">
            ¿Qué edades aceptan?
        </button>

        <div class="faq-answer">
            <p>
                Recibimos niños desde temprana edad
                hasta nivel preescolar.
            </p>
        </div>

    </div>

    <div class="faq-item">

        <button class="faq-question">
            ¿Cómo puedo agendar una cita?
        </button>

        <div class="faq-answer">
            <p>
                Puedes completar el formulario
                de agenda disponible en nuestra página.
            </p>
        </div>

    </div>

</section>


 <section class="presentacion-colegio">

    <div class="contenido-presentacion">

        <img
            src="/img/logo.jpg"
            alt="Logo Jardín Daisiry"
            class="logo-presentacion"
        >

        <h2>
            Jardín de Seño Daisiry
        </h2>

        <p>
            “Abriendo puertas para el futuro”
        </p>

        <a
            href="#cita"
            class="btn"
        >
            Conocer el colegio
        </a>

    </div>

</section>
   

   

   <section class="banner-final">

    <div class="overlay-logo">

        <img
            src="/img/logo.jpg"
            alt="Logo Jardín Daisiry"
            class="logo-centro"
        >

    </div>

</section>


    
   

 <!-- CONTACTOS -->

    <section
        class="contactos"
        id="contactos"
    >

        <h2>Contactos</h2>

        <p>admeljardindedaisiry@gmail.com</p>

        <p>809-806-4041 || +1-809-806-4041</p>

        <p>C. 7, Santiago de los Caballeros 51000</p>

       <iframe src="https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d15047.136953412079!2d-70.6748097!3d19.4648672!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8eb1cf7da9f4b40d%3A0x17566ae84f73dd38!2sEl%20Jardin%20de%20Daisiry!5e0!3m2!1ses!2sdo!4v1778458074167!5m2!1ses!2sdo" width="600" height="450" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade">
       </iframe>

    </section>

</main>