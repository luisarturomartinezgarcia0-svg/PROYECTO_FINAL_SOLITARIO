<main>

    <!-- HERO -->

    <section
        class="hero"
        id="inicio"
    >

        <div class="overlay">

            <h1>
                El Jardín de Seño Daisiry
            </h1>

            <p>
                Más que un colegio: Un hogar, una 
                comunidad, un Jardín.

            </p>

            <a href="#cita" class="btn">
                Conoce el Colegio
            </a>

        </div>

    </section>

    <!-- FORMULARIO -->

    <section
        class="cita"
        id="cita"
    >

        <h2>Agende una Cita</h2>

        <form action="/agendar-cita" method="POST">

            <input
                type="text"
                name="nombre_completo"
                placeholder="Nombre Completo"
                required
            >

            <input
                type="text"
                name="cedula"
                placeholder="Cédula"
                required
            >

            <input
                type="text"
                name="telefono"
                placeholder="Teléfono"
                required
            >

            <input
                type="email"
                name="correo"
                placeholder="Correo Electrónico"
                required
            >

            <button type="submit">
                Agendar Cita
            </button>

        </form>

    </section>

    <!-- MENU SEMANAL -->

   <section
    class="menu"
    id="menu"
>

    <h2>Menú Semanal</h2>

    <div class="tabla-menu">

        <table>

            <thead>

                <tr>
                    <th>Día</th>
                    <th>Desayuno</th>
                    <th>Comida</th>
                    <th>Merienda</th>
                </tr>

            </thead>

            <tbody>

                {{#each menus}}

                <tr>

                    <td>{{dia}}</td>

                    <td>{{desayuno}}</td>

                    <td>{{comida}}</td>

                    <td>{{merienda}}</td>

                </tr>

                {{/each}}

            </tbody>

        </table>

    </div>

</section>

    <!-- GALERIA -->

    <section
        class="galeria"
        id="galeria"
    >

        <img src="/img/foto1.jpg">
        <img src="/img/foto2.jpg">
        <img src="/img/foto3.jpg">

    </section>

    <!-- INSTAGRAM -->

    <section class="instagram">

        <h2>
            ¡Descubre el lugar donde la imaginación cobra vida!
        </h2>

        <a
            href="https://www.instagram.com/eljardindedaisiry"
            target="_blank"
            class="btn"
        >
            Conoce el Instagram
        </a>

    </section>

    <!-- TESTIMONIOS -->

    <section
        class="testimonios"
        id="testimonios"
    >

        <h2>Testimonios</h2>

        <div class="testimonio">

            <h3>María Torres</h3>

            <p>
                Eternamente agradecida con el Jardín de Seño Daisiry por el amor y la dedicación que le brindan a mi hija Paula. Es una tranquilidad inmensa saber que cuenta con un equipo que siempre está presente en su crecimiento y bienestar. ¡Gracias por ser su segundo hogar!
            </p>

        </div>

    </section>

    <!-- CONTACTOS -->

    <section
        class="contactos"
        id="contactos"
    >

        <h2>Contactos</h2>

        <p>admeljardindedaisiry@gmail.com</p>

        <p>809-806-4041 | +1-809-806-4041</p>

        <p>C. 7, Santiago de los Caballeros 51000</p>

       <iframe src="https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d15047.136953412079!2d-70.6748097!3d19.4648672!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8eb1cf7da9f4b40d%3A0x17566ae84f73dd38!2sEl%20Jardin%20de%20Daisiry!5e0!3m2!1ses!2sdo!4v1778458074167!5m2!1ses!2sdo" width="600" height="450" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade">
       </iframe>

    </section>

</main>