<main>

    <!-- HERO -->

    <section
        class="hero"
        id="inicio"
    >

        <div class="overlay">

            <h1>
                El Jardín de Seño Daisiry
            </h1>

            <p>
                Más que un colegio: Un hogar, una 
                comunidad, un Jardín.

            </p>

            <a href="#cita" class="btn">
                Conoce el Colegio
            </a>

        </div>

    </section>

    <!-- FORMULARIO -->

    <section
        class="cita"
        id="cita"
    >

        <h2>Agende una Cita</h2>

        <form action="/agendar-cita" method="POST">

            <input
                type="text"
                name="nombre_completo"
                placeholder="Nombre Completo"
                required
            >

            <input
                type="text"
                name="cedula"
                placeholder="Cédula"
                required
            >

            <input
                type="text"
                name="telefono"
                placeholder="Teléfono"
                required
            >

            <input
                type="email"
                name="correo"
                placeholder="Correo Electrónico"
                required
            >

            <button type="submit">
                Agendar Cita
            </button>

        </form>

    </section>

    <!-- MENU SEMANAL -->

  <section class="menu" id="menu">

    <h2>Menú Semanal</h2>

    <table>

        <thead>

            <tr>
                <th>Día</th>
                <th>Desayuno</th>
                <th>Comida</th>
                <th>Merienda</th>
            </tr>

        </thead>

        <tbody>

            <tr>
                <td>Lunes</td>
                <td>Leche y pan</td>
                <td>Arroz con pollo</td>
                <td>Jugo y galletas</td>
            </tr>

            <tr>
                <td>Martes</td>
                <td>Chocolate y tostadas</td>
                <td>Pasta con carne</td>
                <td>Frutas</td>
            </tr>

            <tr>
                <td>Miércoles</td>
                <td>Mangú con queso</td>
                <td>Arroz y habichuelas</td>
                <td>Yogurt</td>
            </tr>

            <tr>
                <td>Jueves</td>
                <td>Cereal con leche</td>
                <td>Puré con pollo</td>
                <td>Pan y jugo</td>
            </tr>

            <tr>
                <td>Viernes</td>
                <td>Panqueques</td>
                <td>Pizza</td>
                <td>Bizcocho</td>
            </tr>

        </tbody>

    </table>

</section>

